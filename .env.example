# Copiá a ".env" y rellená (el archivo .env no se sube a Git).
#
# RUM web anónimo: mismo valor que el secreto RUM_ANON_INGEST_KEY de la Edge Function ingest-rum-anon.
EXPO_PUBLIC_RUM_ANON_KEY=

# Opcionales (ver app.json → expo.extra y utils/fitengineUrls.js)
# EXPO_PUBLIC_FITENGINE_WEB_APP_URL=
# EXPO_PUBLIC_SENTRY_DSN=

# Trazado auth en consola F12 (utils/authTrace.js). En __DEV__ suele estar ON sin esto.
# EXPO_PUBLIC_AUTH_TRACE=1
# Panel amarillo en pantalla (web): en consola del navegador → localStorage.setItem('fe_auth_trace_overlay','1')
# Ocultar panel: localStorage.setItem('fe_auth_trace_overlay','0'); location.reload()
