{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192"
      },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192",
        "EXPO_USE_COMMUNITY_AUTOLINKING": "1"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production"
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "extends": "production"
    }
  }
}
