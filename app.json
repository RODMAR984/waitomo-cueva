{
  "expo": {
    "name": "FitEngine",
    "slug": "waitomo-cueva",
    "scheme": "waitomo",
    "version": "1.1.0",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/logo-completo-ab.png",
      "resizeMode": "contain",
      "backgroundColor": "#050a0d"
    },
    "icon": "./assets/app-icon-composite.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waitomofitengine.cueva",
      "associatedDomains": [
        "applinks:fitengine.app",
        "applinks:www.fitengine.app"
      ]
    },
    "android": {
      "package": "com.waitomofitengine.cueva",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-composite.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fitengine.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "www.fitengine.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "FitEngine",
      "favicon": "./assets/app-icon-composite.png",
      "backgroundColor": "#021b23",
      "themeColor": "#021b23"
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FitEngine usa el micrófono para dictar el pedido al asistente de IA.",
          "speechRecognitionPermission": "FitEngine transcribe tu voz a texto para el asistente de IA."
        }
      ]
    ],
    "extra": {
      "waitomoOrganizationId": "",
      "fitengineLinksBaseUrl": "https://fitengine.app",
      "fitengineWebAppUrl": "https://app.fitengine.app",
      "fitengineMarketingSiteUrl": "https://waitomofitengine.com",
      "fitenginePrivacyUrl": "https://waitomofitengine.com",
      "fitengineTermsUrl": "https://waitomofitengine.com",
      "fitengineSupportEmail": "soporte@waitomo.com",
      "fitengineSupportPhone": "+54 9 2268 635566",
      "showPaidShortcut": false,
      "eas": {
        "projectId": "b5e327c8-d83e-46ce-8b1c-3ab56b1300c6"
      }
    },
    "owner": "roperezpulti"
  }
}
