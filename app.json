{
  "expo": {
    "name": "Waitomo Cueva",
    "slug": "waitomo-cueva",
    "scheme": "waitomo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waitomofitengine.cueva",
      "associatedDomains": ["applinks:fitengine.app", "applinks:www.fitengine.app"]
    },

    "android": {
      "package": "com.waitomofitengine.cueva",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fitengine.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "www.fitengine.app",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],

    "extra": {
      "waitomoOrganizationId": "",
      "fitengineLinksBaseUrl": "https://fitengine.app",
      "fitengineWebAppUrl": "https://app.fitengine.app",
      "fitengineMarketingSiteUrl": "https://waitomofitengine.com",
      "fitenginePrivacyUrl": "https://waitomofitengine.com",
      "fitengineTermsUrl": "https://waitomofitengine.com",
      "fitengineSupportEmail": "soporte@waitomo.com"
    }
  }
}